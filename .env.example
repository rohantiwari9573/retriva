# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Host is "postgres" (docker network) when running via docker compose.
# If running the backend directly on the host, use localhost:5433 instead -
# port 5433 avoids clashing with a native Postgres install on the default 5432.
DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally, S3 in production) ---
STORAGE_PROVIDER=minio
# Internal endpoint (container-to-container). In production with real S3,
# leave S3_ENDPOINT_URL unset entirely.
S3_ENDPOINT_URL=http://minio:9000
# Endpoint baked into presigned URLs handed to the browser - must be
# reachable from the user's machine, not just from inside Docker.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=nexus-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- LLM / Embeddings ---
# Two interchangeable configurations - see docs/gemini-provider.md for the
# full picture. Only one block should be active (the other commented out);
# both are OpenAI-compatible, so the RAG pipeline code never changes.

# OPTION A (default): local LM Studio - zero cost, requires LM Studio
# running on the host with these two models loaded. See README's "Local
# setup" section for exact setup steps.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen2.5-7b-instruct

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_API_KEY=not-needed-for-local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

# OPTION B: Google Gemini free tier - for a public deployment that must
# keep working without a local machine powered on. Get a free API key at
# https://aistudio.google.com/apikey (no credit card required for the free
# tier). Server-side only - never expose this key to frontend code, never
# commit a real value here. See docs/gemini-provider.md for free-tier
# limitations and exactly what this does and doesn't guarantee.
#
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=REPLACE_WITH_YOUR_OWN_GEMINI_API_KEY
# LLM_MODEL=gemini-3.6-flash
#
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=REPLACE_WITH_YOUR_OWN_GEMINI_API_KEY
# # gemini-embedding-001 specifically, NOT gemini-embedding-2 - the two
# # models' embedding spaces are incompatible, and only 001 has been
# # verified against this project's vector(768) pgvector column without
# # requiring a re-embedding migration. See docs/gemini-provider.md.
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

RERANKER_PROVIDER=none

# --- Conversational RAG / streaming (Phase 6) ---
# Query rewriting resolves conversational references (pronouns, "the
# system", etc.) before retrieval - it's an optimization, never a source
# of truth, and falls back to the original question on any failure.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=10
STREAMING_ENABLED=true

# --- Document processing (Celery) ---
DOCUMENT_PROCESSING_MAX_RETRIES=3
DOCUMENT_PROCESSING_RETRY_BACKOFF_SECONDS=10

# --- Document parser hardening (Phase 7) ---
# Bound a document's *decoded* shape, not just its on-disk byte size (see
# docs/security.md's "Document parser hardening" section for why each one
# exists). Defaults are generous for real documents, tight enough to fail
# fast on a pathological one.
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_TEXT_LENGTH=5000000
MAX_DOCX_UNCOMPRESSED_SIZE_BYTES=100000000

# --- Rate limiting (Phase 7) ---
# Requests per minute per identity - IP for pre-auth endpoints, authenticated
# user for endpoints only reachable once logged in. See docs/security.md's
# "Rate limiting" section.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_RETRY_PER_MINUTE=10
RATE_LIMIT_RETRIEVAL_DEBUG_PER_MINUTE=20

# --- Observability (Phase 8) ---
# Both master switches fail open: if the underlying exporter/library can't
# reach its backend, telemetry is dropped, never allowed to break a
# request. See docs/observability.md.
PROMETHEUS_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=nexus-backend
# Jaeger's all-in-one image accepts OTLP/gRPC natively - no separate
# OpenTelemetry Collector. Only reachable with `docker compose --profile
# observability up`; with OTEL_ENABLED=true and no Jaeger running, span
# export just fails silently in the background (see docs/observability.md
# "Failure isolation").
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Dedicated metrics HTTP server inside the Celery worker process - see
# docs/observability.md's "Celery instrumentation".
WORKER_METRICS_PORT=9808

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
