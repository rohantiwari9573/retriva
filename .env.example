# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Host is "postgres" (docker network) when running via docker compose.
# If running the backend directly on the host, use localhost:5433 instead -
# port 5433 avoids clashing with a native Postgres install on the default 5432.
DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally, S3 in production) ---
STORAGE_PROVIDER=minio
# Internal endpoint (container-to-container). In production with real S3,
# leave S3_ENDPOINT_URL unset entirely.
S3_ENDPOINT_URL=http://minio:9000
# Endpoint baked into presigned URLs handed to the browser - must be
# reachable from the user's machine, not just from inside Docker.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=nexus-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- LLM / Embeddings (local LM Studio by default; OpenAI-compatible) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen2.5-7b-instruct

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_API_KEY=not-needed-for-local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

RERANKER_PROVIDER=none

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
