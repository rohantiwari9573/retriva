{
  "title": "Nexus - RAG Performance",
  "uid": "nexus-rag-performance",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["nexus"],
  "panels": [
    {
      "id": 1, "title": "RAG request rate (streaming vs non-streaming)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(rate(rag_requests_total[5m])) by (streaming)", "legendFormat": "streaming={{streaming}}" }]
    },
    {
      "id": 2, "title": "Retrieval latency (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))", "legendFormat": "retrieval p95" }]
    },
    {
      "id": 3, "title": "Vector vs keyword search latency (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(rag_vector_search_duration_seconds_bucket[5m])) by (le))", "legendFormat": "vector p95" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_keyword_search_duration_seconds_bucket[5m])) by (le))", "legendFormat": "keyword p95" }
      ]
    },
    {
      "id": 4, "title": "Fusion + context-build latency (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(rag_fusion_duration_seconds_bucket[5m])) by (le))", "legendFormat": "RRF fusion p95" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_context_build_duration_seconds_bucket[5m])) by (le))", "legendFormat": "context build p95" }
      ]
    },
    {
      "id": 5, "title": "Query rewrite latency (p95) + fallback rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(rag_query_rewrite_duration_seconds_bucket[5m])) by (le))", "legendFormat": "rewrite p95" },
        { "expr": "sum(rate(rag_query_rewrite_fallbacks_total[5m])) by (reason)", "legendFormat": "fallback: {{reason}}" }
      ]
    },
    {
      "id": 6, "title": "LLM latency (p95) + TTFT (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "LLM total p95" },
        { "expr": "histogram_quantile(0.95, sum(rate(llm_time_to_first_token_seconds_bucket[5m])) by (le))", "legendFormat": "TTFT p95" }
      ]
    }
  ]
}
