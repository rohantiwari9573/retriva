# Production environment template for the Phase 11 AWS deployment.
# Copy to `.env` ON THE DEPLOYMENT HOST ONLY - never commit a real `.env`
# with real secrets, and never store this filled-in file in git. See
# docs/aws-deployment.md for the full deployment procedure.

# --- App ---
ENVIRONMENT=production
DEBUG=false

# --- Security ---
# Generate a fresh value for the real deployment - never reuse the local
# dev secret or any value that has ever appeared in this repo's history:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_GENERATE_A_NEW_RANDOM_SECRET

# This deployment has no domain name and therefore no HTTPS (see
# docs/aws-deployment.md "HTTPS status"). COOKIE_SECURE=true would make
# browsers silently refuse to send the auth cookie over plain HTTP, which
# would break login entirely. This is a genuine, disclosed limitation of
# this specific deployment, not a recommended production setting - the
# correct fix is a domain + TLS certificate, not this flag.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- CORS ---
# Frontend and backend are both served from the same origin through the
# nginx proxy in docker-compose.prod.yml (one public IP, no port in the
# URL) - so this matters less than in local dev, but is still enforced
# server-side. Replace with the deployment's actual public IP or domain.
CORS_ORIGINS=["http://REPLACE_WITH_PUBLIC_IP_OR_DOMAIN"]

# --- Database (self-hosted Postgres+pgvector in Docker - see
# docs/aws-deployment.md "Database configuration" for why RDS was not
# used) ---
DATABASE_URL=postgresql+asyncpg://nexus:REPLACE_ME_DB_PASSWORD@postgres:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=nexus

# --- Redis (self-hosted, same compute host - see docs/aws-deployment.md
# "Redis / Celery configuration") ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (self-hosted MinIO, NOT migrated to S3 - see
# docs/aws-deployment.md "Object storage" for the documented tradeoff) ---
STORAGE_PROVIDER=minio
S3_ENDPOINT_URL=http://minio:9000
# Must be reachable from the user's browser (used to build presigned
# URLs) - the public IP/domain and the published MinIO data port.
S3_PUBLIC_ENDPOINT_URL=http://REPLACE_WITH_PUBLIC_IP_OR_DOMAIN:9000
S3_BUCKET=retriva-documents
S3_ACCESS_KEY=REPLACE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_ME_MINIO_SECRET_KEY
AWS_REGION=ap-southeast-2

# --- LLM / Embeddings ---
# LM Studio is intentionally NOT deployed to AWS (see the Phase 11 spec's
# explicit instruction and docs/aws-deployment.md "LM Studio status"). In
# this deployment there is no reachable LLM/embedding backend at all -
# the application must handle that absence honestly (health checks do not
# depend on it; generation/embedding calls fail with a clear error rather
# than a fabricated result). Left pointing at an address that will not
# resolve/connect from this host on purpose, rather than silently
# swapping in a paid provider.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://lm-studio-not-deployed.invalid:1234/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen2.5-7b-instruct

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://lm-studio-not-deployed.invalid:1234/v1
EMBEDDING_API_KEY=not-needed-for-local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

RERANKER_PROVIDER=none

# --- Conversational RAG / streaming ---
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=10
STREAMING_ENABLED=true

# --- Document processing (Celery) ---
DOCUMENT_PROCESSING_MAX_RETRIES=3
DOCUMENT_PROCESSING_RETRY_BACKOFF_SECONDS=10

# --- Document parser hardening ---
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_TEXT_LENGTH=5000000
MAX_DOCX_UNCOMPRESSED_SIZE_BYTES=100000000

# --- Rate limiting ---
# Trusts nginx's X-Real-IP header (never X-Forwarded-For - see
# app/core/rate_limit.py) for the real client IP, but ONLY when the
# request's direct TCP peer is this exact address - nginx is pinned to
# 172.28.0.10 in docker-compose.prod.yml specifically so this can be a
# fixed value rather than "trust everything on the Docker network".
TRUSTED_PROXY_IPS=["172.28.0.10"]
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_RETRY_PER_MINUTE=10
RATE_LIMIT_RETRIEVAL_DEBUG_PER_MINUTE=20

# --- Observability ---
# Prometheus/Grafana/Jaeger are NOT deployed to AWS (see
# docs/aws-deployment.md "Observability status") - kept local-only per the
# Phase 11 spec's cost guidance. PROMETHEUS_ENABLED stays true because the
# backend's own /metrics endpoint costs nothing to keep running even with
# no Prometheus server scraping it (and it is not proxied publicly - see
# infra/nginx/nginx.conf). OTEL_ENABLED is false because there is no
# Jaeger collector reachable in this deployment; leaving it true would
# just fail open silently on every request, which is harmless but pointless.
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=retriva-backend
WORKER_METRICS_PORT=9808

# --- Frontend ---
# Baked into the frontend's client bundle AT BUILD TIME (Next.js inlines
# NEXT_PUBLIC_* vars during `next build`) - see docs/aws-deployment.md
# "Frontend" for why this must also exist as frontend/.env.local before
# `docker compose build frontend` runs, not just in this file.
NEXT_PUBLIC_API_URL=http://REPLACE_WITH_PUBLIC_IP_OR_DOMAIN
